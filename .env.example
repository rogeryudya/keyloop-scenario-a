# Copy to .env for local runs: cp .env.example .env
# Validated at startup (src/config/env.schema.ts); the app refuses to start on invalid values.
# Variables already set in the shell take precedence over .env.

# development | production | test
NODE_ENV=development
# HTTP port (1-65535)
PORT=3000
# pino log level: fatal | error | warn | info | debug | trace | silent (default info; silent under NODE_ENV=test)
LOG_LEVEL=info

# --- Database: set ONE of these ---
# Secrets Manager secret id holding RDS-format credentials (floci locally after `pnpm infra:up`, AWS in the cloud).
# Takes precedence over DATABASE_URL. Requires AWS_REGION.
DB_SECRET_ID=keyloop/local/db
# Direct connection string: tests/CI only (they set it themselves).
# DATABASE_URL=postgresql://user:password@localhost:5432/keyloop

# --- AWS (floci locally; dummy credentials, not secrets) ---
AWS_REGION=us-east-1
# Custom endpoint: floci from the host. Leave unset in real AWS.
AWS_ENDPOINT_URL=http://localhost:4566
# Read by the AWS SDK credential chain, not by the app config. Use real credentials/roles in AWS.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Observability (OpenTelemetry) ---
# OTLP/HTTP collector: otel-lgtm from the host (Grafana at http://localhost:3001). Unset disables tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=keyloop-api
# Metric export interval in ms (SDK default 60000); short so local dashboards update quickly.
OTEL_METRIC_EXPORT_INTERVAL=10000
