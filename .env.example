# Copy to .env for local runs: cp .env.example .env
# Validated at startup (src/config/env.schema.ts); the app refuses to start on invalid values.
# Variables already set in the shell take precedence over .env.

# development | production | test
NODE_ENV=development
# HTTP port (1-65535)
PORT=3000

# --- Database: set ONE of these ---
# Direct connection string (tests/CI only). The Compose `postgres` service is gone (M4): the local DB is floci RDS,
# reached via DB_SECRET_ID once `pnpm infra:up` exists. Until then, point this at the floci RDS proxy port.
DATABASE_URL=postgresql://keyloop:keyloop@localhost:5432/keyloop
# Secrets Manager secret id (floci locally, AWS in the cloud). Supported from M4; takes precedence over DATABASE_URL.
# DB_SECRET_ID=keyloop/local/db
